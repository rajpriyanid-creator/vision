{
  "name": "vision-adaptive-study",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx tests/workflowTests.ts && tsx tests/graphValidator.test.ts && tsx tests/codeSandbox.test.ts && tsx tests/partPlanner.test.ts && tsx tests/offlineAndFailureIntegrity.test.ts && tsx tests/exerciseAgentQuality.test.ts && tsx tests/exitAndLoopVerification.test.ts",
    "test:workflow": "tsx tests/workflowTests.ts",
    "test:benchmark": "tsx tests/benchmark.ts",
    "test:graph": "tsx tests/graphValidator.test.ts",
    "test:sandbox": "tsx tests/codeSandbox.test.ts",
    "test:planner": "tsx tests/partPlanner.test.ts",
    "test:integrity": "tsx tests/offlineAndFailureIntegrity.test.ts",
    "test:exercise": "tsx tests/exerciseAgentQuality.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@google/genai": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "mongodb": "^7.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
